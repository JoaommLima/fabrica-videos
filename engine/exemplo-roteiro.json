    {
      "id": "b03",
      "narracao": "A VLAN resolve isso. Com o mesmo switch e os mesmos cabos, você cria redes virtuais separadas. Cada grupo de aparelhos só enxerga quem está no próprio grupo.",
      "cena": {
        "tipo": "diagrama",
        "titulo": "Com VLANs",
        "grupos": {
          "v10": "VLAN 10 · Trabalho",
          "v20": "VLAN 20 · Pessoal",
          "v30": "VLAN 30 · IoT"
        },
