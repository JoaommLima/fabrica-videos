  "blocos": [
    {
      "id": "b01",
      "narracao": "Sabe aquela câmera barata que você colocou na sua rede? Ela está no mesmo lugar que o seu computador do trabalho.",
      "cena": {
        "tipo": "abertura",
        "selo": "REDES • EP. 01",
        "titulo": "Uma rede. Várias redes.",
        "subtitulo": "O que é VLAN e por que o seu homelab precisa de uma"
      },
      "inicioAudio": 0.0,
      "duracao": 8.527
    },
    {
      "id": "b02",
      "narracao": "Numa rede doméstica comum, tudo conversa com tudo: o PC, o celular, a TV e aquela câmera. Se um aparelho for invadido, o caminho até os outros está livre.",
