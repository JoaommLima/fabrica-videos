[Unit]
Description=JmLab - avisos da Fabrica de Videos no Telegram
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/nas

[Service]
Type=oneshot
User=jm
Group=jm
LoadCredential=telegram:/etc/jmlab/telegram.env
ExecStart=/usr/bin/python3 -I /usr/local/lib/jmlab/fabrica-avisos.py /srv/nas/arquivos/fabrica/_avisos
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/nas/arquivos/fabrica/_avisos
